# ==============================================================================
# OpenTrace OSINT Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PUBLIC FRONTEND VARIABLES (Safe to expose in client builds)
# ------------------------------------------------------------------------------
# In local development Vite proxies /api to http://127.0.0.1:8000
# In public deployment (e.g. Vercel), set VITE_API_BASE_URL to your backend URL:
# VITE_API_BASE_URL=https://opentrace-api.onrender.com

# ------------------------------------------------------------------------------
# 2. BACKEND STORAGE CONFIGURATION (Secrets / Server-only)
# ------------------------------------------------------------------------------
# Options: memory (volatile, default for tests), sqlite (default for production)
OPENTRACE_STORAGE_MODE=sqlite
OPENTRACE_STORAGE=sqlite
OPENTRACE_SQLITE_PATH=./opentrace.db

# Optional external PostgreSQL connection string (if using managed DB):
# DATABASE_URL=postgresql+asyncpg://user:password@hostname:5432/opentrace

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & SECURITY (Must change in production)
# ------------------------------------------------------------------------------
# High-entropy random string for signing JWT access tokens (at least 32 characters)
OPENTRACE_JWT_SECRET=replace-with-a-secure-random-secret-key-at-least-32-chars
OPENTRACE_JWT_ALGORITHM=HS256
OPENTRACE_ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Initial admin email address (automatically granted 'admin' role on registration)
# OPENTRACE_ADMIN_EMAIL=admin@yourdomain.com

# Toggle public self-registration (true/false)
OPENTRACE_ALLOW_REGISTRATION=true

# Static API key protection for headless server-to-server endpoints (optional)
# OPENTRACE_API_KEY=your_optional_static_api_key_here

# Cross-Origin Resource Sharing (comma-separated origins)
OPENTRACE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,https://opentrace.vercel.app

# ------------------------------------------------------------------------------
# 4. ABUSE PROTECTION & RATE LIMITING
# ------------------------------------------------------------------------------
OPENTRACE_RATE_LIMIT_PER_MINUTE=60
OPENTRACE_AUTH_RATE_LIMIT_PER_MINUTE=10

# ------------------------------------------------------------------------------
# 5. ASYNC SCHEDULER & CONCURRENCY
# ------------------------------------------------------------------------------
OPENTRACE_MAX_CONCURRENCY=5
OPENTRACE_PER_HOST_CONCURRENCY=2

# Timeouts in seconds
OPENTRACE_DEFAULT_TIMEOUT=10.0
OPENTRACE_REQUEST_TIMEOUT_SECONDS=10.0
OPENTRACE_MAX_RUNTIME=60.0
OPENTRACE_MAX_RUNTIME_SECONDS=60.0

# ------------------------------------------------------------------------------
# 6. LOGGING & CLIENT IDENTITY
# ------------------------------------------------------------------------------
OPENTRACE_LOG_LEVEL=INFO
OPENTRACE_USER_AGENT=OpenTraceOSINT/0.1.0 (Public OSINT research platform; respectful crawler)

# ------------------------------------------------------------------------------
# 7. OPTIONAL AUTHORIZED PROVIDER KEYS
# Note: Base engine runs 149 free public adapters without requiring these keys.
# ------------------------------------------------------------------------------
# HIBP_API_KEY=your_haveibeenpwned_api_key
# NUMVERIFY_API_KEY=your_numverify_api_key
# TWILIO_ACCOUNT_SID=your_twilio_sid
# TWILIO_AUTH_TOKEN=your_twilio_auth_token
