# OpenTrace OSINT Configuration
# Canonical names with supported aliases

# Storage Configuration (options: memory, sqlite)
OPENTRACE_STORAGE_MODE=memory
OPENTRACE_STORAGE=memory
OPENTRACE_SQLITE_PATH=./data/opentrace.db

# Concurrency & Rate Limiting
OPENTRACE_MAX_CONCURRENCY=5
OPENTRACE_PER_HOST_CONCURRENCY=2

# Timeouts & Runtime Limits
OPENTRACE_DEFAULT_TIMEOUT=10.0
OPENTRACE_REQUEST_TIMEOUT_SECONDS=10.0
OPENTRACE_MAX_RUNTIME=60.0
OPENTRACE_MAX_RUNTIME_SECONDS=60.0

# Logging & Network Identity
OPENTRACE_LOG_LEVEL=INFO
OPENTRACE_USER_AGENT=OpenTraceOSINT/0.1.0 (Public OSINT research platform)

# Security & CORS
# If OPENTRACE_API_KEY is set, API routes require X-API-Key or Bearer token
# OPENTRACE_API_KEY=your_secure_random_api_key_here
OPENTRACE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Optional Authorized Provider Keys (for explicit integration modules)
# HIBP_API_KEY=your_haveibeenpwned_api_key
# NUMVERIFY_API_KEY=your_numverify_api_key
# TWILIO_ACCOUNT_SID=your_twilio_sid
# TWILIO_AUTH_TOKEN=your_twilio_auth_token
