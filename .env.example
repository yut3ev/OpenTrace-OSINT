OPENTRACE_STORAGE=memory
OPENTRACE_SQLITE_PATH=./data/opentrace.sqlite3
OPENTRACE_LOG_LEVEL=INFO
OPENTRACE_REQUEST_TIMEOUT_SECONDS=8
OPENTRACE_MAX_CONCURRENCY=8
OPENTRACE_PER_HOST_CONCURRENCY=2
OPENTRACE_MAX_RUNTIME_SECONDS=30
OPENTRACE_USER_AGENT=OpenTraceOSINT/0.1 (configure repository URL)
# Optional provider keys should be added only for documented authorized integrations.
