# ==============================================================================
# OpenTrace Frontend Configuration Template
# ==============================================================================

# In local development Vite proxies /api to http://127.0.0.1:8000 automatically.
# When deploying the frontend to Vercel (or any static host) with a backend on Render, Railway, or Fly.io:
# Set VITE_API_BASE_URL to your publicly accessible backend URL without trailing slash.
#
# Example:
# VITE_API_BASE_URL=https://your-opentrace-backend.onrender.com

VITE_API_BASE_URL=
